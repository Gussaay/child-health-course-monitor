rules_version = '2';

// =============================================================================
// NCHP Monitoring — Cloud Storage security rules
//
// See the note at the top of firestore.rules: test these before deploying.
// Limits here must stay in step with validateUpload() in src/data.js, which
// enforces the same rules client-side so the user gets a useful error instead
// of a failed upload.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function withinSize(megabytes) {
      return request.resource.size < megabytes * 1024 * 1024;
    }

    function isImageOrDocument() {
      return request.resource.contentType.matches('image/(png|jpe?g|webp|gif)')
          || request.resource.contentType == 'application/pdf';
    }

    // Attachments from the app: signature images, facility photos, report PDFs.
    match /uploads/{fileName} {
      allow read: if true;   // download URLs are unguessable and shared in reports
      allow write: if signedIn() && withinSize(5) && isImageOrDocument();
    }

    // APKs published by the deploy workflow. The in-app "Download update"
    // button fetches these with ?alt=media and no login, so they stay readable.
    match /apks/{fileName} {
      allow read: if true;
      allow write: if false;  // CI writes with a service account, bypassing rules
    }

    // Course material for the Online Courses module: module books, exercise
    // booklets, the chart booklet and two videos.
    //
    // READ is restricted to signed-in users, matching the decision that online
    // courses are staff-only.
    //
    // WRITE is any signed-in user, and that is deliberately WEAKER than the UI,
    // which only offers the upload screen to federal managers and super users.
    // Storage rules cannot read Firestore, so they cannot see the `role` field
    // the rest of this system authorises on, and this app does not set custom
    // auth claims. Tightening it properly means putting the role into a custom
    // claim at sign-in; until then the limits below are what constrain it:
    // nothing but course documents and video, and nothing enormous.
    match /online-courses/{allPaths=**} {
      allow read: if request.auth != null;

      // Create and update are limited by size and type. Delete is NOT, and
      // cannot be: on a delete `request.resource` is null, so a rule that asks
      // about its size denies every delete. That is what stopped the course
      // bin removing a section's pictures when it was emptied.
      allow create, update: if request.auth != null
        && request.resource.size < 200 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('video/.*')
            || request.resource.contentType.matches('image/(png|jpe?g|webp)'));

      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
