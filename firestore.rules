rules_version = '2';

// =============================================================================
// NCHP Monitoring — Firestore security rules
//
// This file is the LIVE production ruleset with one change: the `users`
// collection no longer lets a signed-in account grant itself privileges.
// Everything else — including every public read and every unauthenticated
// form — is byte-for-byte what was already deployed and working.
//
// That restraint is deliberate. An earlier version of this file was written
// from scratch by reading src/data.js, and it silently dropped collections the
// app uses (course_sub_types) and closed public paths the app depends on
// (participant registration, public course reports, online exercises). Rules
// are not a place to guess: start from what is deployed and change one thing.
//
// Testing:  npm run test:rules   (Firestore emulator, tests/rules/)
// Rollback: Firebase console → Firestore → Rules → version history.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // --- Helper Functions ---
    // =========================================================================

    // Safely get the user document
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Safely check if user is a super user (checks both string and array)
    function isSuperUser() {
      let doc = getUserDoc();
      return doc.role == 'super_user' || (doc.roles != null && 'super_user' in doc.roles);
    }

    // High-level managers (Federal/Super/State)
    function isManager() {
      let doc = getUserDoc();
      return isSuperUser() ||
             doc.role in ['federal_manager', 'states_manager'] ||
             (doc.roles != null && doc.roles.hasAny(['federal_manager', 'states_manager']));
    }

    // Check if the user is a Locality Manager
    function isLocalityManager() {
      let doc = getUserDoc();
      return doc.role == 'locality_manager' || (doc.roles != null && 'locality_manager' in doc.roles);
    }

    // Who may edit the sub-course catalogue. Deliberately NOT isManager():
    // that also admits states_manager, but the UI only shows the sub-course
    // tools to federal managers and super users. Keeping the two in sync means
    // the rule never silently permits more than the interface offers.
    function isSubCourseEditor() {
      let doc = getUserDoc();
      return isSuperUser() ||
             doc.role == 'federal_manager' ||
             (doc.roles != null && 'federal_manager' in doc.roles);
    }

    // The fields that decide what a person can do. A user must never write
    // these on their own document — that is the whole point of this file's one
    // change. Cloud Functions use the Admin SDK, which bypasses rules entirely,
    // so listing them here restricts the client and nothing else.
    function privilegedUserFields() {
      return ['role', 'roles', 'permissions', 'assignedState', 'assignedLocality',
              'assignedLocalities', 'isAdmin', 'access'];
    }

    function writesNoPrivilegedFields() {
      return !request.resource.data.keys().hasAny(privilegedUserFields());
    }

    function privilegedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(privilegedUserFields());
    }

    // =========================================================================
    // --- Core Data Collections ---
    // =========================================================================

    match /federalCoordinators/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /facilitators/{facilitatorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /stateCoordinators/{docId} {
      allow read, write: if request.auth != null;
    }
    match /localityCoordinators/{docId} {
      allow read, write: if request.auth != null;
    }
    match /coordinators/{coordinatorId} {
      allow read, write: if request.auth != null;
    }
    match /funders/{funderId} {
      allow read, write: if request.auth != null;
    }

    match /skillMentorship/{mentorshipId} {
      allow read, write: if request.auth != null;
    }

    // --- PROJECT TRACKER, MASTER PLAN, OPERATIONAL PLANS & MEETINGS ---
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isManager();
    }

    match /masterPlans/{planId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isManager() || isLocalityManager());
    }

    match /operationalPlans/{planId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isManager() || isLocalityManager());
    }

    match /unitMeetings/{meetingId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if request.auth != null && isManager();
    }

    // --- IMNCI & EENC Visit Reports ---
    match /imnciVisitReports/{reportId} {
      function isOwner() {
        return request.auth.token.email == resource.data.mentorEmail;
      }
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && (isOwner() || isManager());
    }

    match /eencVisitReports/{reportId} {
      function isOwner() {
        return request.auth.token.email == resource.data.mentorEmail;
      }
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && (isOwner() || isManager());
    }

    // =========================================================================
    // --- NEW: IMNCI Patient Records (From the clinical form) ---
    match /imnciPatientRecords/{recordId} {
      allow create: if true; // Allows public forms to save data
      allow read: if true;   // Allows dashboards to fetch the data
      allow update, delete: if request.auth != null;
    }
    // =========================================================================

    // --- Health Facilities & Snapshots ---
    match /healthFacilities/{facilityId} {
      allow read: if true;
      allow write: if request.auth != null && isManager();
    }
    match /facilitySnapshots/{snapshotId} {
      allow read: if request.auth != null && isManager();
      allow write: if request.auth != null && isManager();
    }

    // --- Pending Submissions ---
    match /facilitySubmissions/{submissionId} {
      allow create: if true;
      allow read, update: if request.auth != null && isManager();
    }
    match /coordinatorSubmissions/{docId} {
      allow create: if request.resource.data.name is string && request.resource.data.email is string && request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null;
    }
    match /federalCoordinatorSubmissions/{docId} {
      allow create: if request.resource.data.name is string && request.resource.data.email is string && request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null;
    }
    match /localityCoordinatorSubmissions/{docId} {
      allow create: if request.resource.data.name is string && request.resource.data.email is string && request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null;
    }
    match /facilitatorSubmissions/{submissionId} {
      allow create: if request.resource.data.name is string && request.resource.data.phone is string && request.resource.data.email is string && request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null;
    }

    // --- Application Settings ---
    match /appSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openCount']) &&
          request.resource.data.openCount == resource.data.openCount + 1
        );
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openCount']) &&
          request.resource.data.openCount == resource.data.openCount + 1
        );
    }

    // --- Course-Related Collections ---

    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================================================================
    // --- Sub-course Catalogue (runtime additions, e.g. 'ETAT TOT') ---
    // Built-in sub-courses ship in constants.js and are not stored here; only
    // entries added from the system by a federal manager or super user live in
    // this collection.
    //
    // Read is public to match /courses and /facilitators — these are reference
    // labels, not sensitive data, and a public course view may need to render a
    // sub-course name.
    //
    // Update is denied outright: the UI only ever adds or removes an entry, so
    // renaming in place would silently orphan every course already saved with
    // the old string.
    //
    // NOTE: hasOnly() rejects any write carrying an extra field. If this
    // document ever gains a key (sortOrder, isActive, ...), add it here too or
    // creates will start failing with a permission error that looks nothing
    // like a schema problem. The 120-char cap mirrors the client-side check in
    // addCustomSubCourse — change one, change both.
    // =========================================================================
    match /course_sub_types/{subTypeId} {
      allow read: if true;

      allow create: if request.auth != null && isSubCourseEditor()
        && request.resource.data.keys().hasOnly(
             ['course_type', 'name', 'createdBy', 'createdByRole', 'createdAt'])
        && request.resource.data.course_type is string
        && request.resource.data.course_type.size() > 0
        && request.resource.data.course_type.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;

      allow update: if false;

      allow delete: if request.auth != null && isSubCourseEditor();
    }
    // =========================================================================

    match /participants/{participantId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    match /observations/{observationId} {
      allow read: if request.auth != null || get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.isPublic == true;
      allow write: if request.auth != null;
    }
    match /cases/{caseId} {
      allow read: if request.auth != null || get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.isPublic == true;
      allow write: if request.auth != null;
    }
    match /finalReports/{reportId} {
      allow read: if request.auth != null || get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.isPublic == true;
      allow write: if request.auth != null;
    }

    match /participantTests/{testRecordId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // =========================================================================
    // --- Online Training Exercises (IMNCI online IMCI course) ---
    // Opened from an unauthenticated public link, the same as participantTests,
    // so read and create are public. Writes are validated rather than trusted:
    // the document id must be built from the record's own courseId,
    // participantId and exerciseId, which stops an anonymous caller writing
    // into an arbitrary attempt document.
    // =========================================================================
    match /exerciseAttempts/{attemptId} {
      allow read: if true;

      allow create, update: if
           request.resource.data.courseId is string
        && request.resource.data.participantId is string
        && request.resource.data.exerciseId is string
        && request.resource.data.attemptNo is int
        && request.resource.data.percent is number
        && request.resource.data.percent >= 0
        && request.resource.data.percent <= 100
        && attemptId == request.resource.data.courseId + '__' +
                        request.resource.data.participantId + '__' +
                        request.resource.data.exerciseId + '__' +
                        string(request.resource.data.attemptNo);

      allow delete: if request.auth != null;
    }
    // =========================================================================

    // =========================================================================
    // --- Online Exercise Definitions (authored in Manage Exercises) ---
    // Read is public because the participant link renders them unauthenticated.
    // Only signed-in users may author or edit.
    // =========================================================================
    match /exerciseDefinitions/{exerciseId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    // =========================================================================

    // =========================================================================
    // --- System Notifications ---
    match /notifications/{notificationId} {
      allow read: if request.auth != null;

      // Allow public users to trigger/send a notification (required for unauthenticated forms)
      allow create: if true;

      // Keep modifications and deletions restricted to managers
      allow update, delete: if request.auth != null && isManager();
    }
    // =========================================================================

    // =========================================================================
    // --- Email Queue ---
    // =========================================================================
    match /mail/{docId} {
      // Allows authenticated users to queue emails for sending certificates
      allow create: if request.auth != null;
      // Prevents users from reading, updating, or deleting queued emails
      allow read, update, delete: if false;
    }
    // =========================================================================

    // --- User and Meta Collections ---
    //
    // THE ONE CHANGE IN THIS FILE.
    //
    // Before: `allow create/update: if request.auth.uid == userId` with no
    // restriction on which fields. Since the entire UI gates on the
    // `permissions` map stored here, any signed-in account could open the
    // browser console, set permissions.canUseSuperUserAdvancedFeatures = true
    // on its own document, reload, and hold super-user rights.
    //
    // Now a user may still maintain their own document — display name, phone,
    // fcmToken — but not the fields that decide what they can do. Managers are
    // unaffected and can still administer other people exactly as before; the
    // createUserProfile and setUserRoles Cloud Functions use the Admin SDK and
    // bypass rules entirely.
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId
                    && writesNoPrivilegedFields();

      allow read: if request.auth.uid == userId || (request.auth != null && isManager());

      allow update: if (request.auth != null && isManager())
                    || (request.auth.uid == userId && privilegedFieldsUnchanged());
    }

    // Written only by the sendFCMNotification Cloud Function, to stop one
    // account broadcasting to every device in a loop. No client may touch it.
    match /notificationRateLimits/{userId} {
      allow read, write: if false;
    }

    match /userUsageStats/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (request.auth.uid == userId || isManager());
    }

    // =========================================================================
    // --- APP UPDATE PIPELINE & META ---
    // =========================================================================

    match /update_history/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSuperUser();
    }

    match /meta/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSuperUser();
    }
  }
}
