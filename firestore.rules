rules_version = '2';

// =============================================================================
// NCHP Monitoring — Firestore security rules
//
// Derived from the LIVE production ruleset. The public paths the app genuinely
// depends on — participant registration, public course reports, online
// exercises, the sub-course catalogue — are unchanged and covered by tests,
// because an earlier rewrite of this file guessed at them from src/data.js and
// silently broke them. Rules are not a place to guess.
//
// Changes since that ruleset, each one traced to the code that proves it safe:
//
//   * users/{uid} — a signed-in account cannot grant itself privileges, and
//     only a super user can grant super_user.
//   * isStaff() — sign-up is open to the public, so `request.auth != null` on
//     a write rule meant "anyone on the internet". Programme data now needs a
//     real role.
//   * imnciPatientRecords — was world-readable. It holds children's names and
//     clinical classifications.
//   * mail/{id} — was an open relay through the Trigger Email extension.
//   * exerciseAttempts — an anonymous caller could rewrite another learner's
//     score, which feeds certificates.
//   * unitMeetings — the anonymous link marks attendance and nothing else.
//
// KNOWN AND ACCEPTED: /participants is publicly readable and writable. It
// carries health workers' names, phones and emails. Closing it would put a
// sign-in in front of the registration and certificate links that courses are
// run on, so it was left open deliberately. See the note on that match block.
//
// Testing:  npm run test:rules   (Firestore emulator, tests/rules/)
// Rollback: Firebase console → Firestore → Rules → version history.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // --- Helper Functions ---
    // =========================================================================

    // Safely get the user document
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Safely check if user is a super user (checks both string and array)
    function isSuperUser() {
      let doc = getUserDoc();
      return doc.role == 'super_user' || (doc.roles != null && 'super_user' in doc.roles);
    }

    // High-level managers (Federal/Super/State)
    function isManager() {
      let doc = getUserDoc();
      return isSuperUser() ||
             doc.role in ['federal_manager', 'states_manager'] ||
             (doc.roles != null && doc.roles.hasAny(['federal_manager', 'states_manager']));
    }

    // Check if the user is a Locality Manager
    function isLocalityManager() {
      let doc = getUserDoc();
      return doc.role == 'locality_manager' || (doc.roles != null && 'locality_manager' in doc.roles);
    }

    // Anyone holding a real job in the programme, as opposed to a brand-new
    // account. Sign-up is open to the public (auth-ui.jsx calls
    // createUserWithEmailAndPassword with no invite or domain check) and
    // createUserProfile gives every new account role 'user', so
    // `request.auth != null` on a write rule meant "anyone on the internet who
    // filled in a sign-up form". This is the allowlist of roles that actually
    // administer data; 'user' is deliberately absent.
    //
    // It is an allowlist rather than `role != 'user'` so that an unrecognised
    // or misspelled role fails closed instead of inheriting write access.
    function staffRoles() {
      return ['super_user', 'federal_manager', 'states_manager', 'locality_manager',
              'federal_coordinator', 'facilitator', 'state_coordinator', 'course_coordinator'];
    }

    // The request.auth check is not redundant: without it an anonymous caller
    // makes getUserDoc() read users/null, which raises an evaluation error
    // rather than returning false. That still denies, but it denies by
    // crashing, it costs a document read on every anonymous write attempt, and
    // it buries the real reason in the emulator log.
    function isStaff() {
      return request.auth != null && hasStaffRole();
    }

    function hasStaffRole() {
      let doc = getUserDoc();
      return (doc.roles != null && doc.roles.hasAny(staffRoles()))
             || (doc.roles == null && doc.role in staffRoles());
    }

    // Who may edit the sub-course catalogue. Deliberately NOT isManager():
    // that also admits states_manager, but the UI only shows the sub-course
    // tools to federal managers and super users. Keeping the two in sync means
    // the rule never silently permits more than the interface offers.
    function isSubCourseEditor() {
      let doc = getUserDoc();
      return isSuperUser() ||
             doc.role == 'federal_manager' ||
             (doc.roles != null && 'federal_manager' in doc.roles);
    }

    // The fields that decide what a person can do. A user must never write
    // these on their own document — that is the whole point of this file's one
    // change. Cloud Functions use the Admin SDK, which bypasses rules entirely,
    // so listing them here restricts the client and nothing else.
    function privilegedUserFields() {
      return ['role', 'roles', 'permissions', 'assignedState', 'assignedLocality',
              'assignedLocalities', 'isAdmin', 'access'];
    }

    function writesNoPrivilegedFields() {
      return !request.resource.data.keys().hasAny(privilegedUserFields());
    }

    function privilegedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(privilegedUserFields());
    }

    // =========================================================================
    // --- Core Data Collections ---
    // =========================================================================

    match /federalCoordinators/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /facilitators/{facilitatorId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /stateCoordinators/{docId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }
    match /localityCoordinators/{docId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }
    match /coordinators/{coordinatorId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }
    match /funders/{funderId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

    match /skillMentorship/{mentorshipId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

    // =========================================================================
    // --- SUPERVISION ASSESSMENTS ---
    //
    // Facility assessments carried out by federal, state and locality managers.
    // Staff read them because the findings drive follow-up across the
    // programme; only the managers who supervise may write them, which is what
    // isManager() plus isLocalityManager() already means elsewhere in this file.
    // =========================================================================
    match /supervisionAssessments/{assessmentId} {
      allow read: if isStaff();
      allow write: if request.auth != null && (isManager() || isLocalityManager());
    }

    // =========================================================================
    // --- POPULATION TARGETS ---
    //
    // Projected denominators by year and locality. Read is open to any
    // signed-in user because coverage figures throughout the app divide by
    // them and a state needs to see its own. Writing is federal: these are the
    // national projections, and a locality revising its own denominator would
    // silently change its own reported coverage.
    // =========================================================================
    match /populationTargets/{targetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSubCourseEditor();
    }

    // =========================================================================
    // --- SUPPLY MANAGEMENT ---
    //
    // The essential supply lists decide what every service is expected to have
    // in stock, and their quantification parameters drive the national
    // forecast, so writing them is a federal decision. isSubCourseEditor() is
    // the existing helper for "federal manager or super user" and is reused
    // here rather than adding a second spelling of the same rule — but note it
    // deliberately excludes states_manager, which isManager() would admit.
    //
    // Read is open to any signed-in user: a state or locality needs to see the
    // list it is expected to stock against.
    // =========================================================================
    match /supplyItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSubCourseEditor();
    }

    // --- PROJECT TRACKER, MASTER PLAN, OPERATIONAL PLANS & MEETINGS ---
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isManager();
    }

    match /masterPlans/{planId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isManager() || isLocalityManager());
    }

    match /operationalPlans/{planId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isManager() || isLocalityManager());
    }

    // The /public/meeting/{id} link lets an invitee mark their own attendance
    // without signing in, which is why update was `if true`. That also let any
    // passer-by rewrite the title, the invitee list or the session dates of
    // any meeting. The anonymous path is now narrowed to the one field that
    // screen actually changes; everything else needs a manager.
    //
    // upsertUnitMeeting() merges the whole meeting object back, but
    // affectedKeys() only reports keys whose value really changed, so an
    // unmodified field does not trip this.
    match /unitMeetings/{meetingId} {
      allow read: if true;
      allow update: if (request.auth != null && isManager())
                    || request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['attendance', 'lastUpdatedAt']);
      allow create, delete: if request.auth != null && isManager();
    }

    // --- IMNCI & EENC Visit Reports ---
    //
    // Mentorship reports name the facility, the mentor and the providers
    // assessed. Adding one needs canAddMentorshipVisit and reading them needs
    // canViewSkillsMentorship, neither of which the default 'user' role has, so
    // `request.auth != null` was wider than the interface it backs.
    match /imnciVisitReports/{reportId} {
      function isOwner() {
        return request.auth.token.email == resource.data.mentorEmail;
      }
      allow create: if isStaff();
      allow read: if isStaff();
      allow update, delete: if request.auth != null && (isOwner() || isManager());
    }

    match /eencVisitReports/{reportId} {
      function isOwner() {
        return request.auth.token.email == resource.data.mentorEmail;
      }
      allow create: if isStaff();
      allow read: if isStaff();
      allow update, delete: if request.auth != null && (isOwner() || isManager());
    }

    // =========================================================================
    // --- IMNCI Patient Records (From the clinical form) ---
    //
    // These documents carry childName alongside the IMNCI assessment and
    // classification — identifiable clinical data about children. Both read and
    // create were `if true`, so the whole collection could be downloaded by
    // anyone who knew the project id, which ships in the client bundle.
    //
    // There is no public form behind this. IMNCIRecordingForm is only ever
    // rendered from App.jsx for a signed-in user holding canViewCourse, and
    // saveIMNCIPatientRecord in src/data.js has no other caller. The old
    // comment describing a "public form" did not match the application.
    match /imnciPatientRecords/{recordId} {
      allow create: if isStaff();
      allow read: if request.auth != null;
      allow update, delete: if isStaff();
    }
    // =========================================================================

    // --- Health Facilities & Snapshots ---
    match /healthFacilities/{facilityId} {
      allow read: if true;
      allow write: if request.auth != null && isManager();
    }
    match /facilitySnapshots/{snapshotId} {
      allow read: if request.auth != null && isManager();
      allow write: if request.auth != null && isManager();
    }

    // --- Pending Submissions ---
    match /facilitySubmissions/{submissionId} {
      allow create: if true;
      allow read, update: if request.auth != null && isManager();
    }
    // Submission queues hold applicants' names, phones and emails, and
    // approving one creates a real coordinator or facilitator record. Reading
    // and acting on the queue is staff work, not something a fresh sign-up
    // should reach.
    match /coordinatorSubmissions/{docId} {
      allow create: if request.resource.data.name is string && request.resource.data.email is string && request.resource.data.status == 'pending';
      allow read, update, delete: if isStaff();
    }
    match /federalCoordinatorSubmissions/{docId} {
      allow create: if request.resource.data.name is string && request.resource.data.email is string && request.resource.data.status == 'pending';
      allow read, update, delete: if isStaff();
    }
    match /localityCoordinatorSubmissions/{docId} {
      allow create: if request.resource.data.name is string && request.resource.data.email is string && request.resource.data.status == 'pending';
      allow read, update, delete: if isStaff();
    }
    match /facilitatorSubmissions/{submissionId} {
      allow create: if request.resource.data.name is string && request.resource.data.phone is string && request.resource.data.email is string && request.resource.data.status == 'pending';
      allow read, update, delete: if isStaff();
    }

    // --- Application Settings ---
    // The anonymous branch is the app-open counter and stays. The signed-in
    // branch is what configures the application for everyone, so it is staff.
    match /appSettings/{docId} {
      allow read: if true;
      allow write: if isStaff() || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openCount']) &&
          request.resource.data.openCount == resource.data.openCount + 1
        );
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff() || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openCount']) &&
          request.resource.data.openCount == resource.data.openCount + 1
        );
    }

    // --- Course-Related Collections ---

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // =========================================================================
    // --- Sub-course Catalogue (runtime additions, e.g. 'ETAT TOT') ---
    // Built-in sub-courses ship in constants.js and are not stored here; only
    // entries added from the system by a federal manager or super user live in
    // this collection.
    //
    // Read is public to match /courses and /facilitators — these are reference
    // labels, not sensitive data, and a public course view may need to render a
    // sub-course name.
    //
    // Update is denied outright: the UI only ever adds or removes an entry, so
    // renaming in place would silently orphan every course already saved with
    // the old string.
    //
    // NOTE: hasOnly() rejects any write carrying an extra field. If this
    // document ever gains a key (sortOrder, isActive, ...), add it here too or
    // creates will start failing with a permission error that looks nothing
    // like a schema problem. The 120-char cap mirrors the client-side check in
    // addCustomSubCourse — change one, change both.
    // =========================================================================
    match /course_sub_types/{subTypeId} {
      allow read: if true;

      allow create: if request.auth != null && isSubCourseEditor()
        && request.resource.data.keys().hasOnly(
             ['course_type', 'name', 'createdBy', 'createdByRole', 'createdAt'])
        && request.resource.data.course_type is string
        && request.resource.data.course_type.size() > 0
        && request.resource.data.course_type.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;

      allow update: if false;

      allow delete: if request.auth != null && isSubCourseEditor();
    }
    // =========================================================================

    // ACCEPTED RISK, decided deliberately: read, create and update stay open.
    // These documents hold health workers' names, phone numbers and emails, and
    // anyone can query the collection. Closing it would require sign-in on the
    // public registration, shared-report and certificate links, which is how
    // courses are actually run in the field, so the exposure is accepted rather
    // than overlooked. Revisit together with App Check, which would at least
    // bind this surface to the real app.
    match /participants/{participantId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isStaff();
    }

    match /observations/{observationId} {
      allow read: if request.auth != null || get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.isPublic == true;
      allow write: if isStaff();
    }
    match /cases/{caseId} {
      allow read: if request.auth != null || get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.isPublic == true;
      allow write: if isStaff();
    }
    match /finalReports/{reportId} {
      allow read: if request.auth != null || get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.isPublic == true;
      allow write: if isStaff();
    }

    // Create stays public: participants sit tests from an unauthenticated link.
    match /participantTests/{testRecordId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaff();
    }

    // =========================================================================
    // --- Online Training Exercises (IMNCI online IMCI course) ---
    // Opened from an unauthenticated public link, the same as participantTests,
    // so read and create are public. Writes are validated rather than trusted:
    // the document id must be built from the record's own courseId,
    // participantId and exerciseId, which stops an anonymous caller writing
    // into an arbitrary attempt document.
    // =========================================================================
    match /exerciseAttempts/{attemptId} {
      allow read: if true;

      function wellFormed() {
        return request.resource.data.courseId is string
          && request.resource.data.participantId is string
          && request.resource.data.exerciseId is string
          && request.resource.data.attemptNo is int
          && request.resource.data.percent is number
          && request.resource.data.percent >= 0
          && request.resource.data.percent <= 100
          && attemptId == request.resource.data.courseId + '__' +
                          request.resource.data.participantId + '__' +
                          request.resource.data.exerciseId + '__' +
                          string(request.resource.data.attemptNo);
      }

      allow create: if wellFormed();

      // The id check above only proves a document is internally consistent, not
      // that the person writing it owns the attempt. With update also open,
      // anyone could recompute another learner's attempt id and overwrite their
      // score — and these scores feed certificates.
      //
      // Update stays anonymous purely so the offline queue can replay its own
      // setDoc after reconnect (see the deterministic-id note in src/data.js),
      // so it is allowed only when it does not move the mark. Re-sitting an
      // exercise writes a new document with the next attemptNo, which is a
      // create, so genuine retries are unaffected.
      allow update: if (wellFormed() && request.resource.data.percent == resource.data.percent)
        || isStaff();

      allow delete: if isStaff();
    }
    // =========================================================================

    // =========================================================================
    // --- Online Exercise Definitions (authored in Manage Exercises) ---
    // Read is public because the participant link renders them unauthenticated.
    // Only signed-in users may author or edit.
    // =========================================================================
    match /exerciseDefinitions/{exerciseId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }
    // =========================================================================

    // =========================================================================
    // --- System Notifications ---
    match /notifications/{notificationId} {
      allow read: if request.auth != null;

      // Was `if true`, described as "required for unauthenticated forms". No
      // such form exists: every caller of addDoc(collection(db,
      // 'notifications')) sits behind a screen that App.jsx renders only for a
      // signed-in user, and FacilityForms.jsx guards its own call with
      // `if (currentUser)`. Anonymous create bought nothing and let anyone fill
      // every manager's notification tray.
      //
      // Not isStaff(): submitting a facility update is something a plain
      // account legitimately does, and that submission notifies the reviewers.
      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;

      // Keep modifications and deletions restricted to managers
      allow update, delete: if request.auth != null && isManager();
    }
    // =========================================================================

    // =========================================================================
    // --- Email Queue ---
    // =========================================================================
    // A document here is picked up by the Trigger Email extension and delivered
    // from the programme's verified sender address, with whatever `to`,
    // `subject` and `html` it contains. `request.auth != null` therefore meant
    // that anyone who signed themselves up could send mail as the National
    // Child Health Program — a phishing channel with the organisation's own
    // reputation behind it.
    //
    // Restricted to staff and to the one shape sendCertificateEmail writes, so
    // a compromised staff account cannot queue arbitrary attachments, headers
    // or bcc lists either.
    match /mail/{docId} {
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['to', 'message'])
        && request.resource.data.to is string
        && request.resource.data.to.size() <= 320
        && request.resource.data.message.keys().hasOnly(['subject', 'html'])
        && request.resource.data.message.subject is string
        && request.resource.data.message.subject.size() <= 200
        && request.resource.data.message.html is string
        && request.resource.data.message.html.size() <= 20000;

      // Prevents users from reading, updating, or deleting queued emails
      allow read, update, delete: if false;
    }
    // =========================================================================

    // --- User and Meta Collections ---
    //
    // THE ONE CHANGE IN THIS FILE.
    //
    // Before: `allow create/update: if request.auth.uid == userId` with no
    // restriction on which fields. Since the entire UI gates on the
    // `permissions` map stored here, any signed-in account could open the
    // browser console, set permissions.canUseSuperUserAdvancedFeatures = true
    // on its own document, reload, and hold super-user rights.
    //
    // Now a user may still maintain their own document — display name, phone,
    // fcmToken — but not the fields that decide what they can do. Managers are
    // unaffected and can still administer other people exactly as before; the
    // createUserProfile and setUserRoles Cloud Functions use the Admin SDK and
    // bypass rules entirely.
    // A second gap, below the one described above: managers may administer
    // other people's profiles, and nothing stopped a manager writing
    // role: 'super_user' onto a second account and signing into it. The
    // setUserRoles Cloud Function refuses to do that, but AdminDashboard.jsx
    // never calls it — it writes users/{uid} straight from the browser, so the
    // function's guards were never in the path.
    //
    // Super user is the role that can rewrite meta/update_config, which decides
    // the APK URL every device downloads, so granting it has to stay with the
    // people who already hold it.
    function grantsSuperUser() {
      return request.resource.data.get('role', '') == 'super_user'
             || ('super_user' in request.resource.data.get('roles', []));
    }

    function alreadySuperUser() {
      return resource.data.get('role', '') == 'super_user'
             || ('super_user' in resource.data.get('roles', []));
    }

    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId
                    && writesNoPrivilegedFields();

      allow read: if request.auth.uid == userId || (request.auth != null && isManager());

      allow update: if (request.auth != null && isManager()
                        && (isSuperUser() || !grantsSuperUser() || alreadySuperUser()))
                    || (request.auth.uid == userId && privilegedFieldsUnchanged());
    }

    // Written only by the sendFCMNotification Cloud Function, to stop one
    // account broadcasting to every device in a loop. No client may touch it.
    match /notificationRateLimits/{userId} {
      allow read, write: if false;
    }

    match /userUsageStats/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (request.auth.uid == userId || isManager());
    }

    // =========================================================================
    // --- APP UPDATE PIPELINE & META ---
    // =========================================================================

    match /update_history/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSuperUser();
    }

    match /meta/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSuperUser();
    }
  }
}
