<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The APK is downloaded with isSystemFile: true, which puts it in the app's
      cache folder. Without a <cache-path> entry, FileProvider refuses to share
      it and the Android installer never opens.
    -->
    <cache-path name="cache" path="." />
    <files-path name="files" path="." />

    <!-- Reports and exports saved to Directory.Documents -->
    <external-files-path name="external_files" path="." />
    <external-cache-path name="external_cache" path="." />
    <external-path name="external" path="." />
</paths>
