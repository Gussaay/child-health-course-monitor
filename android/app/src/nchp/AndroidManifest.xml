<?xml version="1.0" encoding="utf-8" ?>
<!-- Merged into src/main/AndroidManifest.xml for this app only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="com.nchp.monitoring.app.MainActivity">
            <!--
              Shared links of the main site open in the NCHP app (Android App
              Links). EmONC and ch-sudan links open in their own apps.
              The sites prove the app is theirs with /.well-known/assetlinks.json,
              which the deploy writes from the signing key (deploy.yml, "Write
              Android App Links file"); without it Android opens the link in the
              browser. Only the shared-page paths are claimed; /training/ links
              stay in the browser because a training link turns the whole tab
              into the practice copy. <data> lines in one filter combine: every
              host with every path.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="imnci-courses-monitor.web.app" />
                <data android:host="imnci-courses-monitor.firebaseapp.com" />
                <data android:pathPrefix="/public/" />
                <data android:pathPrefix="/attendance/" />
                <data android:pathPrefix="/monitor/" />
                <data android:pathPrefix="/verify/" />
                <data android:pathPrefix="/mentorship/" />
                <data android:pathPrefix="/facilities/" />
                <data android:pathPrefix="/submit/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
